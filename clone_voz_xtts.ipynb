{\n  \"nbformat\": 4,\n  \"nbformat_minor\": 0,\n  \"metadata\": {\n    \"colab\": {\n      \"name\": \"Clone_Voz_XTTS_Colab.ipynb\",\n      \"provenance\": [],\n      \"gpuType\": \"T4\"\n    },\n    \"kernelspec\": {\n      \"name\": \"python3\",\n      \"display_name\": \"Python 3\"\n    },\n    \"language_info\": {\n      \"name\": \"python\"\n    },\n    \"accelerator\": \"GPU\"\n  },\n  \"cells\": [\n    {\n      \"cell_type\": \"markdown\",\n      \"metadata\": {},\n      \"source\": [\n        \"# 🎙️ Estúdio de Clonagem de Voz (XTTS-v2)\\n\",\n        \"### Pipeline Gratuito com GPU T4 e Geração Ilimitada\\n\",\n        \"\\n\",\n        \"Este notebook permite clonar a voz do seu irmão a partir da amostra gravada e gerar narrações completas para qualquer novo roteiro em Português do Brasil.\\n\",\n        \"\\n\",\n        \"> 💡 **Como usar:**\\n\",\n        \"> 1. Verifique se o Colab está conectado com GPU: no menu superior, clique em **Ambiente de execução** > **Alterar tipo de ambiente de execução** > Selecione **T4 GPU**.\\n\",\n        \"> 2. Execute a **Célula 1** (instalação das dependências).\\n\",\n        \"> 3. Execute a **Célula 2** (inicialização do modelo e interface Web).\\n\",\n        \"> 4. Abra o link público do **Gradio** (`xxxx.gradio.live`) que aparecerá no final da execução!\"\n      ]\n    },\n    {\n      \"cell_type\": \"markdown\",\n      \"metadata\": {},\n      \"source\": [\n        \"## ⚙️ Célula 1: Instalação das Dependências (Leva ~1 a 2 minutos)\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"metadata\": {},\n      \"execution_count\": null,\n      \"outputs\": [],\n      \"source\": [\n        \"# Instalação rápida das dependências\\n\",\n        \"!pip install -q coqui-tts gradio\\n\",\n        \"print(\\\"\\\\n✅ Dependências instaladas com sucesso!\\\")\\n\"\n      ]\n    },\n    {\n      \"cell_type\": \"markdown\",\n      \"metadata\": {},\n      \"source\": [\n        \"## 🚀 Célula 2: Inicialização do Modelo e Interface Web\"\n      ]\n    },\n    {\n      \"cell_type\": \"code\",\n      \"metadata\": {},\n      \"execution_count\": null,\n      \"outputs\": [],\n      \"source\": [\n        \"import os\\n\",\n        \"os.environ[\\\"COQUI_TOS_AGREED\\\"] = \\\"1\\\"\\n\",\n        \"import torch\\n\",\n        \"import gradio as gr\\n\",\n        \"import transformers.pytorch_utils\\n\",\n        \"\\n\",\n        \"# Patch 1: Compatibilidade com transformers recente (isin_mps_friendly)\\n\",\n        \"if not hasattr(transformers.pytorch_utils, \\\"isin_mps_friendly\\\"):\\n\",\n        \"    transformers.pytorch_utils.isin_mps_friendly = torch.isin\\n\",\n        \"\\n\",\n        \"# Patch 2: Fix cirúrgico definitivo de attention_mask.shape no gpt_inference\\n\",\n        \"import TTS.tts.layers.xtts.gpt_inference as gpt_inf\\n\",\n        \"_orig_forward = gpt_inf.GPT2InferenceModel.forward\\n\",\n        \"\\n\",\n        \"def patched_forward(self, *args, **kwargs):\\n\",\n        \"    input_ids = kwargs.get(\\\"input_ids\\\", args[0] if len(args) > 0 else None)\\n\",\n        \"    past_key_values = kwargs.get(\\\"past_key_values\\\", args[1] if len(args) > 1 else None)\\n\",\n        \"    attention_mask = kwargs.get(\\\"attention_mask\\\", args[2] if len(args) > 2 else None)\\n\",\n        \"    \\n\",\n        \"    if attention_mask is None and input_ids is not None:\\n\",\n        \"        if past_key_values is not None:\\n\",\n        \"            seq_len = past_key_values[0][0].shape[-2] + input_ids.shape[1]\\n\",\n        \"        else:\\n\",\n        \"            seq_len = input_ids.shape[1]\\n\",\n        \"            if hasattr(self, \\\"cached_prefix_emb\\\") and self.cached_prefix_emb is not None:\\n\",\n        \"                seq_len += self.cached_prefix_emb.shape[1]\\n\",\n        \"        attention_mask = torch.ones((input_ids.shape[0], seq_len), dtype=torch.long, device=input_ids.device)\\n\",\n        \"        if \\\"attention_mask\\\" in kwargs or len(args) <= 2:\\n\",\n        \"            kwargs[\\\"attention_mask\\\"] = attention_mask\\n\",\n        \"        else:\\n\",\n        \"            args = list(args)\\n\",\n        \"            args[2] = attention_mask\\n\",\n        \"            args = tuple(args)\\n\",\n        \"            \\n\",\n        \"    return _orig_forward(self, *args, **kwargs)\\n\",\n        \"\\n\",\n        \"gpt_inf.GPT2InferenceModel.forward = patched_forward\\n\",\n        \"\\n\",\n        \"from TTS.api import TTS\\n\",\n        \"\\n\",\n        \"# 1. Verificar aceleração GPU\\n\",\n        \"device = \\\"cuda\\\" if torch.cuda.is_available() else \\\"cpu\\\"\\n\",\n        \"print(f\\\"🔥 Dispositivo ativo: {device.upper()}\\\")\\n\",\n        \"if device != \\\"cuda\\\":\\n\",\n        \"    print(\\\"⚠️ ATENÇÃO: Nenhuma GPU detectada. Ative a GPU T4 em: Ambiente de execução > Alterar tipo de ambiente de execução > T4 GPU\\\")\\n\",\n        \"\\n\",\n        \"# 2. Carregar modelo XTTS-v2\\n\",\n        \"print(\\\"📥 Carregando modelo XTTS-v2...\\\")\\n\",\n        \"tts = TTS(\\\"tts_models/multilingual/multi-dataset/xtts_v2\\\").to(device)\\n\",\n        \"print(\\\"✅ Modelo pronto para síntese vocal!\\\")\\n\",\n        \"\\n\",\n        \"# 3. Função de Clonagem de Voz\\n\",\n        \"def sintetizar_clone(audio_referencia, texto_roteiro, velocidade, idioma):\\n\",\n        \"    if not audio_referencia:\\n\",\n        \"        return None, \\\"❌ Por favor, faça o upload de um áudio de referência da voz.\\\"\\n\",\n        \"    if not texto_roteiro or not texto_roteiro.strip():\\n\",\n        \"        return None, \\\"❌ Por favor, digite o texto do roteiro a ser narrado.\\\"\\n\",\n        \"    \\n\",\n        \"    output_file = \\\"audio_clonado_final.wav\\\"\\n\",\n        \"    try:\\n\",\n        \"        tts.tts_to_file(\\n\",\n        \"            text=texto_roteiro.strip(),\\n\",\n        \"            speaker_wav=audio_referencia,\\n\",\n        \"            language=idioma,\\n\",\n        \"            file_path=output_file\\n\",\n        \"        )\\n\",\n        \"        return output_file, \\\"✅ Narração gerada com sucesso!\\\"\\n\",\n        \"    except Exception as e:\\n\",\n        \"        import traceback\\n\",\n        \"        traceback.print_exc()\\n\",\n        \"        return None, f\\\"❌ Erro na síntese: {str(e)}\\\"\\n\",\n        \"\\n\",\n        \"# 4. Construção da Interface Web (Gradio)\\n\",\n        \"with gr.Blocks(theme=gr.themes.Soft(primary_hue=\\\"blue\\\")) as demo:\\n\",\n        \"    gr.Markdown(\"# 🎙️ Estúdio de Clonagem de Voz (XTTS-v2)\\\")\\n\",\n        \"    gr.Markdown(\\\"Suba a amostra de áudio do seu irmão, cole o roteiro e gere áudios clonados com entonação humana e natural.\\\")\\n\",\n        \"    \\n\",\n        \"    with gr.Row():\\n\",\n        \"        with gr.Column(scale=1):\\n\",\n        \"            audio_input = gr.Audio(\\n\",\n        \"                label=\\\"1. Áudio de Referência (Voz do seu irmão)\\\",\\n\",\n        \"                type=\\\"filepath\\\"\\n\",\n        \"            )\\n\",\n        \"            gr.Markdown(\\\"💡 *Dica: Suba o arquivo `amostra_voz_irmao_30s.wav` que geramos.*\\\")\\n\",\n        \"            \\n\",\n        \"            with gr.Accordion(\\\"Opções Avançadas\\\", open=False):\\n\",\n        \"                idioma_input = gr.Dropdown(\\n\",\n        \"                    choices=[\\\"pt\\\", \\\"en\\\", \\\"es\\\", \\\"fr\\\"],\\n\",\n        \"                    value=\\\"pt\\\",\\n\",\n        \"                    label=\\\"Idioma da Fala\\\"\\n\",\n        \"                )\\n\",\n        \"                speed_slider = gr.Slider(\\n\",\n        \"                    minimum=0.7,\\n\",\n        \"                    maximum=1.4,\\n\",\n        \"                    value=1.0,\\n\",\n        \"                    step=0.05,\\n\",\n        \"                    label=\\\"Velocidade da Narração (1.0 = normal)\\\"\\n\",\n        \"                )\\n\",\n        \"        \\n\",\n        \"        with gr.Column(scale=2):\\n\",\n        \"            text_input = gr.Textbox(\\n\",\n        \"                label=\\\"2. Roteiro / Texto a ser narrado\\\",\\n\",\n        \"                placeholder=\\\"Cole aqui o texto do novo roteiro que você deseja que ele narre...\\\",\\n\",\n        \"                lines=8\\n\",\n        \"            )\\n\",\n        \"            btn_gerar = gr.Button(\\\"🚀 Gerar Narração com a Voz Clonada\\\", variant=\\\"primary\\\", size=\\\"lg\\\")\\n\",\n        \"            \\n\",\n        \"            status_output = gr.Markdown(\\\"\\\")\\n\",\n        \"            audio_output = gr.Audio(label=\\\"3. Áudio Final Clonado\\\", type=\\\"filepath\\\")\\n\",\n        \"    \\n\",\n        \"    btn_gerar.click(\\n\",\n        \"        fn=sintetizar_clone,\\n\",\n        \"        inputs=[audio_input, text_input, speed_slider, idioma_input],\\n\",\n        \"        outputs=[audio_output, status_output]\\n\",\n        \"    )\\n\",\n        \"\\n\",\n        \"demo.launch(share=True, debug=True)\\n\"\n      ]\n    }\n  ]\n}